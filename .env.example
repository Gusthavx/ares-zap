# Banco (docker compose up -d sobe um Postgres em 127.0.0.1:5433)
DATABASE_URL=postgres://areszap:areszap@127.0.0.1:5433/areszap

# Segredo da aplicação: assina o login e cifra tokens da API oficial. Mínimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# Servidor (API + painel)
PORT=3100
HOST=127.0.0.1
# 1 quando estiver atrás de proxy HTTPS (cookie Secure + IP real)
TRUST_PROXY=0
COOKIE_SECURE=0

# Pasta dos arquivos (mídia enviada e recebida)
DATA_DIR=./data

# Opcionais
LOG_LEVEL=info
BAILEYS_LOG_LEVEL=warn
GRAPH_API_VERSION=v23.0
MAX_INBOUND_MEDIA_MB=16
RATE_LIMIT_PER_MIN=600
# FFMPEG_PATH=ffmpeg
